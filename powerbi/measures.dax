goals_per90 = DIVIDE(90 * SUM(fct_player_seasons[goals]), SUM(fct_player_seasons[minutes]))
assists_per90 = DIVIDE(90 * SUM(fct_player_seasons[assists]), SUM(fct_player_seasons[minutes]))
key_passes_per90 = DIVIDE(90 * SUM(fct_player_seasons[passes_key]), SUM(fct_player_seasons[minutes]))
tackles_per90 = DIVIDE(90 * SUM(fct_player_seasons[tackles_total]), SUM(fct_player_seasons[minutes]))
pass_accuracy_pct = DIVIDE(100 * SUM(fct_player_seasons[passes_completed]), SUM(fct_player_seasons[passes_total]))
duel_success_pct = DIVIDE(100 * SUM(fct_player_seasons[duels_won]), SUM(fct_player_seasons[duels_total]))
dribble_attempts_per90 = DIVIDE(90 * SUM(fct_player_seasons[dribbles_attempts]), SUM(fct_player_seasons[minutes]))
dribble_success_pct = DIVIDE(100 * SUM(fct_player_seasons[dribbles_success]), SUM(fct_player_seasons[dribbles_attempts]))
goal_involvements_per90 = DIVIDE(90 * (SUM(fct_player_seasons[goals]) + SUM(fct_player_seasons[assists])), SUM(fct_player_seasons[minutes]))
successful_dribbles_per90 = DIVIDE(90 * SUM(fct_player_seasons[dribbles_success]), SUM(fct_player_seasons[minutes]))
shot_accuracy_pct = DIVIDE(100 * SUM(fct_player_seasons[shots_on_target]), SUM(fct_player_seasons[shots_total]))
goal_conversion_pct = DIVIDE(100 * SUM(fct_player_seasons[goals]), SUM(fct_player_seasons[shots_total]))
fouls_per_tackle = DIVIDE(1 * SUM(fct_player_seasons[fouls_committed]), SUM(fct_player_seasons[tackles_total]))
shots_per90 = DIVIDE(90 * SUM(fct_player_seasons[shots_total]), SUM(fct_player_seasons[minutes]))
passes_per90 = DIVIDE(90 * SUM(fct_player_seasons[passes_total]), SUM(fct_player_seasons[minutes]))
fouls_drawn_per90 = DIVIDE(90 * SUM(fct_player_seasons[fouls_drawn]), SUM(fct_player_seasons[minutes]))
