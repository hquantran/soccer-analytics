// Import bi_player_seasons. DIVIDE returns BLANK for a zero denominator.
Goals per 90 = DIVIDE(90 * SUM(bi_player_seasons[goals]), SUM(bi_player_seasons[minutes]))
Assists per 90 = DIVIDE(90 * SUM(bi_player_seasons[assists]), SUM(bi_player_seasons[minutes]))
Key passes per 90 = DIVIDE(90 * SUM(bi_player_seasons[passes_key]), SUM(bi_player_seasons[minutes]))
Tackles per 90 = DIVIDE(90 * SUM(bi_player_seasons[tackles_total]), SUM(bi_player_seasons[minutes]))
Pass accuracy % = DIVIDE(100 * SUM(bi_player_seasons[passes_completed]), SUM(bi_player_seasons[passes_total]))
Duel success % = DIVIDE(100 * SUM(bi_player_seasons[duels_won]), SUM(bi_player_seasons[duels_total]))
Dribble attempts per 90 = DIVIDE(90 * SUM(bi_player_seasons[dribbles_attempts]), SUM(bi_player_seasons[minutes]))
Dribble success % = DIVIDE(100 * SUM(bi_player_seasons[dribbles_success]), SUM(bi_player_seasons[dribbles_attempts]))
goal_involvements_per90 = DIVIDE(90 * (SUM(bi_player_seasons[goals]) + SUM(bi_player_seasons[assists])), SUM(bi_player_seasons[minutes]))
successful_dribbles_per90 = DIVIDE(90 * SUM(bi_player_seasons[dribbles_success]), SUM(bi_player_seasons[minutes]))
shot_accuracy_pct = DIVIDE(100 * SUM(bi_player_seasons[shots_on_target]), SUM(bi_player_seasons[shots_total]))
goal_conversion_pct = DIVIDE(100 * SUM(bi_player_seasons[goals]), SUM(bi_player_seasons[shots_total]))
fouls_per_tackle = DIVIDE(1 * SUM(bi_player_seasons[fouls_committed]), SUM(bi_player_seasons[tackles_total]))
shots_per90 = DIVIDE(90 * SUM(bi_player_seasons[shots_total]), SUM(bi_player_seasons[minutes]))
passes_per90 = DIVIDE(90 * SUM(bi_player_seasons[passes_total]), SUM(bi_player_seasons[minutes]))
fouls_drawn_per90 = DIVIDE(90 * SUM(bi_player_seasons[fouls_drawn]), SUM(bi_player_seasons[minutes]))
