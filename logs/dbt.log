 interval }} as bigint) * 7) * interval 1 day)\n    {%- else -%}\n        ({{ from_date_or_timestamp }} + cast({{ interval }} as bigint) * interval 1 {{ unit }})\n    {%- endif -%}\n\n{% endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'datepart', 'type': None, 'description': ''}, {'name': 'interval', 'type': None, 'description': ''}, {'name': 'from_date_or_timestamp', 'type': None, 'description': ''}], 'created_at': 1788726217.0433717, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__datediff': {'name': 'duckdb__datediff', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\utils\\datediff.sql', 'original_file_path': 'macros\\utils\\datediff.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__datediff', 'macro_sql': "{% macro duckdb__datediff(first_date, second_date, datepart) -%}\n    {% if datepart == 'week' %}\n            ({{ datediff(first_date, second_date, 'day') }} // 7 + case\n            when date_part('dow', ({{first_date}})::timestamp) <= date_part('dow', ({{second_date}})::timestamp) then\n                case when {{first_date}} <= {{second_date}} then 0 else -1 end\n            else\n                case when {{first_date}} <= {{second_date}} then 1 else 0 end\n        end)\n    {% else %}\n        (date_diff('{{ datepart }}', {{ first_date }}::timestamp, {{ second_date}}::timestamp ))\n    {% endif %}\n{%- endmacro %}", 'depends_on': {'macros': ['macro.dbt.datediff']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'first_date', 'type': None, 'description': ''}, {'name': 'second_date', 'type': None, 'description': ''}, {'name': 'datepart', 'type': None, 'description': ''}], 'created_at': 1788726217.0447247, 'suppor