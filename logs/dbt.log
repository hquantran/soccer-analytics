ables are always allocated in the DuckdDB client\'s memory, even when called from a MotherDuck connection. #}\n\n    {% set tmp_identifier = base_relation.identifier ~ suffix ~ py_current_timestring() %}\n    {% do return(base_relation.incorporate(\n                                  path={\n                                    "identifier": tmp_identifier,\n                                    "schema": none,\n                                    "database": none\n                                  })) -%}\n{% endmacro %}', 'depends_on': {'macros': ['macro.dbt.py_current_timestring']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'base_relation', 'type': None, 'description': ''}, {'name': 'suffix', 'type': None, 'description': ''}], 'created_at': 1788488626.1853192, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__dispatch_temporary_relation': {'name': 'duckdb__dispatch_temporary_relation', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__dispatch_temporary_relation', 'macro_sql': "{% macro duckdb__dispatch_temporary_relation(target_relation, batch_id='') %}\n    {# Prepares a relation that is meant to be temporary.\n\n     This macro is called when creating the temporary relations needed for incremental models and snapshots.\n\n     When running against duckdb,\n     it dispatches to standard dbt-core machinery to create a temporary table.\n     However, MotherDuck doesn't support server-side temporary tables,\n     so it dispatches to a fully qualified unique table relation under a temporary schema. #}\n\n    {% if adapter.is_motherduck() %}\n        {% set relation = target_relation.incorporate(\n            path=adapter.get_temp_relation_path(target_relation, batch_id)\n        ) %}\n        {% do run_query(create_schema(relation)) %}\n        {% if not adapter.disable_transactions() %}\n            {% do adapter.commit() %}\n        {% endif %}\n        {% do return({'relation': relation, 'temporary': false}) %}\n    {% else %}\n        {% do return({\n            'relation': make_temp_relation(target_relation),\n            'temporary': true\n        }) %}\n    {% endif %}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.run_query', 'macro.dbt.create_schema', 'macro.dbt.make_temp_relation']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'target_relation', 'type': None, 'description': ''}, {'name': 'batch_id', 'type': None, 'description': ''}], 'created_at': 1788488626.1859381, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__current_timestamp': {'name': 'duckdb__current_timestamp', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__current_timestamp', 'macro_sql': '{% macro duckdb__current_timestamp() -%}\n  now()\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [], 'created_at': 1788488626.1860301, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__snapshot_string_as_time': {'name': 'duckdb__snapshot_string_as_time', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__snapshot_string_as_time', 'macro_sql': '{% macro duckdb__snapshot_string_as_time(timestamp) -%}\n    {%- set result = "\'" ~ timestamp ~ "\'::timestamp" -%}\n    {{ return(result) }}\n{%- endmacro %}', 'depends_on': {'macros':