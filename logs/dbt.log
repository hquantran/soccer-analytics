bt_duckdb', 'path': 'macros\\catalog.sql', 'original_file_path': 'macros\\catalog.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__get_catalog_columns_sql', 'macro_sql': "{% macro duckdb__get_catalog_columns_sql(information_schema) -%}\n    select *\n    from (\n        select\n            c.database_name as table_database,\n            c.schema_name as table_schema,\n            c.table_name as table_name,\n            c.column_name as column_name,\n            c.column_index as column_index,\n            c.data_type as column_type,\n            c.comment as column_comment\n        from duckdb_columns() c\n        where upper(c.database_name) = upper('{{ information_schema.database }}')\n    ) catalog_columns\n{%- endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'information_schema', 'type': None, 'description': ''}], 'created_at': 1788488626.195195, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__get_catalog_results_sql': {'name': 'duckdb__get_catalog_results_sql', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\catalog.sql', 'original_file_path': 'macros\\catalog.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__get_catalog_results_sql', 'macro_sql': '{% macro duckdb__get_catalog_results_sql() -%}\n    select\n        tables.table_database,\n        tables.table_schema,\n        tables.table_name,\n        tables.table_type,\n        tables.table_comment,\n        columns.column_name,\n        columns.column_index,\n        columns.column_type,\n        columns.column_comment,\n        null as table_owner\n    from tables\n    join columns using (table_database, table_schema, table_name)\n    order by table_schema, table_name, column_index\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 